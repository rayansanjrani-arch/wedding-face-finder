# Security
SECRET_KEY=your-super-secret-key-min-32-chars-long-change-me
ADMIN_PASSWORD_HASH=$2b$12$...  # bcrypt hash of your admin password

# Paths
PHOTOS_DIR=photos
UPLOADS_DIR=uploads
THUMBNAILS_DIR=thumbnails
DATA_DIR=data

# Face Recognition
TOLERANCE=0.50
MODEL=cnn

# Privacy & Security
ENCRYPT_ENCODINGS=false
DATA_RETENTION_DAYS=30
AUDIT_SEARCHES=true

# Rate Limiting
RATE_LIMIT_STORAGE=memory

# Flask
FLASK_ENV=development
FLASK_DEBUG=false
